# Spotter reminder engine — local only, never deployed.
# Copy to engine/.env (gitignored) or export these in the shell.

# Neon POOLED connection string (same as the app's DATABASE_URL).
DATABASE_URL=

# Local WAHA on the laptop.
WAHA_URL=http://localhost:3000
WAHA_API_KEY=

# Pause between reminder sends, ms (reduces WhatsApp flagging risk).
# Promotions use a randomised 5–12 s gap instead.
SEND_DELAY_MS=4000

# Tries before a job / promotion part is marked failed.
MAX_ATTEMPTS=3

# --- Promotions runner (send-promotions.mjs, CR-10) ---
# The deployed app — the runner downloads promo image bytes from
# GET ${APP_URL}/api/promo-media/[id] and base64-attaches them to WAHA.
APP_URL=https://your-app.vercel.app
# Bearer secret for that endpoint (same value as the app's PROMO_MEDIA_SECRET).
# Unset here or on the app -> the endpoint 503s and promotions send text-only.
PROMO_MEDIA_SECRET=
