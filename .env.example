# Spotter — local environment
#
# Locally these come from `vercel env pull .env.local` (do NOT commit .env.local).
# This file documents every variable the app and its scripts read.

# --- Database (Neon, wired by the Vercel integration) ---
# Pooled connection (pgbouncer) — the running app.
DATABASE_URL=
# Direct connection — migrations / DDL (drizzle-kit, db/migrate.ts).
DATABASE_URL_UNPOOLED=

# --- Auth (added in Phase 1) ---
# 32+ random bytes, base64. Generate: openssl rand -base64 48
SESSION_SECRET=

# --- App ---
# Public base URL. Optional in Vercel (falls back to VERCEL_PROJECT_PRODUCTION_URL
# / VERCEL_URL); set it for local dev if a feature needs absolute links.
APP_URL=http://localhost:3000

# --- Cron (added in Phase 3.3) ---
# Shared secret Vercel Cron sends as `Authorization: Bearer <value>`. Set it on
# Vercel so /api/cron/* can't be run by anyone else. Generate: openssl rand -hex 32
CRON_SECRET=

# --- Credential vault (added in Phase C / CR-6) ---
# Encrypts the retrievable one-time staff password at rest (AES-256-GCM).
# 32 random bytes, base64. Generate: openssl rand -base64 32
# Unset -> the "Show temp password" feature is disabled; "Reset password" still
# works (it regenerates and shows the value once, storing nothing).
CREDENTIAL_ENC_KEY=

# --- Promotions media (added in Phase F / CR-10) ---
# Google service account (JSON key, single line) used to upload promo images to
# Google Drive and read them back, server-side only.
# Unset -> image upload is disabled in the UI; text-only promotions still work.
GOOGLE_SERVICE_ACCOUNT_JSON=
# The Drive folder promo images are uploaded into.
GDRIVE_PROMO_FOLDER_ID=
# Shared secret the local engine sends as `Authorization: Bearer <value>` to
# GET /api/promo-media/[id] to fetch image bytes. Generate: openssl rand -hex 32
# Unset -> that endpoint returns 503 and the engine sends promotions text-only,
# marking the image part `skipped`.
PROMO_MEDIA_SECRET=

# --- Mail (added in Phase 1.3, Gmail SMTP + app password) ---
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# --- WAHA (local sender engine only — NOT set in Vercel; WAHA is not
#     internet-reachable. Used by engine/ scripts in the parent folder.) ---
WAHA_URL=http://localhost:3000
WAHA_API_KEY=
